<nav class="header">
    <ul>
        <li><strong>{{ appName }}</strong></li>
        <li><a href="#" class="contrast">Home</a></li>
        <li><a href="#" class="contrast">All ToDos</a></li>
    </ul>

    <ul>
        {% if isLoggedIn %}
            <li><span>{{ username }}</span></li>
            <li>
                <button class="contrast" onclick="logout()">Выйти</button>
            </li>
        {% else %}
            <li>
                <button class="contrast" onclick="openModal(document.getElementById('signin'))">Войти</button>
            </li>
            <li>
                <button class="contrast" onclick="openModal(document.getElementById('signup'))">Регистрация</button>
            </li>
        {% endif %}
    </ul>
</nav>