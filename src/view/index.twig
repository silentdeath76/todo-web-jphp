<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/html" data-theme="">
<head>
    <meta charset="UTF-8">
    <title>Home</title>
    <link rel="stylesheet" href="static/css/pico.min.css">
    <link rel="stylesheet" href="static/css/base.css">

    <script>
        (function () {
            const saved = localStorage.getItem('theme');
            const theme = saved || (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
            document.documentElement.setAttribute('data-theme', theme);
        })();
    </script>
</head>
<body>

{% include 'header' %}

<div class="container">
    {% include 'controls' %}

    <div id="container" class="container">
        {% if isLoggedIn %}
            <span aria-busy="true" style="text-align: center; display: block;">Loading...</span>
        {% else %}
            <span aria-busy="false" style="text-align: center; display: block ruby;">Войдите в аккаунт чтобы продолжить</span>
        {% endif %}
    </div>

    {% include 'modal/card-create' %}
    {% include 'modal/task-create' %}
    {% include 'modal/signin' %}
    {% include 'modal/signup' %}

</div>
</body>
<script type="text/javascript" src="static/js/base.js"></script>
<script src="static/js/modal.js"></script>
</html>