<dialog id="card-create">
    <article>
        <header>
            <button aria-label="Close" rel="prev" onclick="closeModal(document.getElementById('card-create'))"></button>
            <h3>Создание карточки</h3>
        </header>
        <p>
            <input type="text" id="card-title" placeholder="Заголовок карточки">
            <textarea id="card-details" cols="30" rows="6" placeholder="Описание..."></textarea>
        </p>
        <footer>
            <button class="secondary" onclick="closeModal(document.getElementById('card-create'))">
                Отмена
            </button>
            <button onclick="cardManager.createCard()">Создать</button>
        </footer>
    </article>
</dialog>